# ── Funnel-бот: переменные окружения ──────────────────────────────
# Скопируй этот файл в .env и заполни значения (в .env, не сюда).

# Токен бота-воронки (от @BotFather). ОБЯЗАТЕЛЬНО.
FUNNEL_BOT_TOKEN=

# Твой Telegram ID (админ). Не обязателен для работы, но пусть будет.
FUNNEL_ADMIN_ID=

# Секрет для защиты webhook и служебных эндпоинтов (/funnel/setup, /funnel/last-file).
# Любая длинная случайная строка. ОБЯЗАТЕЛЬНО для прода.
FUNNEL_WEBHOOK_SECRET=

# Публичный https-адрес сервиса (без слэша в конце). Напр.:
# https://your-app.up.railway.app
# Нужен для Mini App и webhook. Локально можно оставить пустым.
PUBLIC_BASE_URL=

# local | production
ENV=local
